PORT=3000
APP_BASE_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com

# Stripe (для Visa/MasterCard/Card)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SUCCESS_URL=https://your-domain.com/index.html?payment=success
STRIPE_CANCEL_URL=https://your-domain.com/index.html?payment=cancel

# Прямые ссылки для реальных платежей (поддерживают placeholders {amount} и {currency})
PAYMENT_LINK_SBP=https://example-payments.com/sbp?amount={amount}&currency={currency}
PAYMENT_LINK_MIR=https://example-payments.com/mir?amount={amount}&currency={currency}
PAYMENT_LINK_CRYPTO=https://example-payments.com/crypto?amount={amount}&currency={currency}
