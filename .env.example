PORT=3000
APP_BASE_URL=https://www.speeddash-pro.com
ALLOWED_ORIGINS=https://www.speeddash-pro.com,https://speeddash-pro.com

# Stripe (для Visa/MasterCard/Card)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SUCCESS_URL=https://www.speeddash-pro.com/index.html?payment=success
STRIPE_CANCEL_URL=https://www.speeddash-pro.com/index.html?payment=cancel

# Прямые ссылки для реальных платежей (поддерживают placeholders {amount} и {currency})
PAYMENT_LINK_SBP=https://example-payments.com/sbp?amount={amount}&currency={currency}
PAYMENT_LINK_MIR=https://example-payments.com/mir?amount={amount}&currency={currency}
PAYMENT_LINK_CRYPTO=https://example-payments.com/crypto?amount={amount}&currency={currency}
PAYMENT_LINK_YOOKASSA=https://example-payments.com/yookassa?amount={amount}&currency={currency}

# Онлайн курс USD -> RUB (fallback, если API курса временно недоступен)
DEFAULT_USD_RUB_RATE=90

